# Copy to .env for local dev. On Render, set these in the service's Environment tab.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/darpan
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
# AI director (an agent in your AgenticOrg workspace)
AGENTICORG_API_KEY=
AGENTICORG_DIRECTOR_AGENT_ID=
# Optional
# PORT=3000
# UPLOAD_DIR=/tmp/darpan-uploads
# MAX_UPLOAD_MB=200
# AGENTICORG_BASE_URL=https://app.agenticorg.ai
# SARVAM_SPEAKER=priya
